DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentorsync
DB_PORT=5432
# "disable" for a local/docker-compose Postgres; "require" for a hosted DB that mandates TLS
# (Neon, Supabase, RDS, etc.)
DB_SSLMODE=disable
PORT=8000
JWT_SECRET=change-me-to-a-long-random-string

# Restricts which origins the API accepts cross-origin requests from. "*" is fine for local
# dev; in production set this to the deployed frontend's exact origin, e.g.
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app
CORS_ALLOW_ORIGINS=*

# Set to "false" to disable running migrations automatically on API server boot (e.g. for
# multi-replica production deploys that run `make migrate` / `cmd/migrate` as a separate step).
# DB_AUTO_MIGRATE=true

# Password the demo accounts (admin@mentorsync.com / mentor@mentorsync.com /
# mentee@mentorsync.com) get set to on migration. Set this to "password" to keep the old
# local-dev convenience login; leave unset on anything reachable from outside your machine — a
# random one-time password is generated and logged instead.
# SEED_USER_PASSWORD=
